#cloud-config
# Example SSH setup: replace/merge with your OWN personal cloud-init template if required.
# Refresh package indexes before installing the web server package.
package_update: true
packages:
  # Apache serves HTTP requests on the web instance.
  - apache2

# Keep the default OS user and create the SSH-enabled Brunner administrator.
users:
  - default
  - name: brunner
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-rsa  # Adam's SSH public key.

# Require SSH keys, disable password-based SSH, and prevent root SSH login.
ssh_pwauth: false
disable_root: true

# Harden the SSH daemon with key-only access.
write_files:
  - path: /etc/ssh/sshd_config.d/99-brunner-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      KbdInteractiveAuthentication no

# Start Apache at boot, reload SSH to apply hardening, and record setup status.
runcmd:
  - [systemctl, enable, --now, apache2]
  - [systemctl, reload, ssh]
  - echo, "Einrichtung durch cloud-init abgeschlossen", >, /var/log/m346.log
