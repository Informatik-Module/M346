#cloud-config
# Example SSH setup: replace/merge with your OWN personal cloud-init template if required.
# Refresh package indexes before installing MariaDB.
package_update: true
packages:
  # Install the MariaDB server on the private database instance.
  - mariadb-server

# Keep the default OS user and create the SSH-enabled Brunner administrator.
users:
  - default
  - name: brunner
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-rsa  # Adam's SSH public key.

# Require SSH keys, disable password-based SSH, and prevent root SSH login.
ssh_pwauth: false
disable_root: true

# Configure SSH hardening and MariaDB's network listener in one write_files list.
write_files:
  - path: /etc/ssh/sshd_config.d/99-brunner-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      PermitRootLogin no
      KbdInteractiveAuthentication no
  - path: /etc/mysql/mariadb.conf.d/99-m346.cnf
    owner: root:root
    permissions: "0644"
    content: |
      [mysqld]
      bind-address = 0.0.0.0

# Start MariaDB, reload SSH settings, and record setup completion.
runcmd:
  - [systemctl, enable, --now, mariadb]
  - [systemctl, restart, mariadb]
  - [systemctl, reload, ssh]
  - echo, "Einrichtung durch cloud-init abgeschlossen", >, /var/log/m346.log
